<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.webshare"
       name="Webshare.cz"
       version="1.0.0"
       provider-name="webshare">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.22.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="sk">Webshare.cz video plugin</summary>
        <summary lang="en">Webshare.cz video plugin</summary>
        <description lang="sk">Vyhľadávajte a prehrávajte videá z webshare.cz</description>
        <description lang="en">Search and play videos from webshare.cz</description>
        <platform>all</platform>
        <license>MIT</license>
    </extension>
</addon>
